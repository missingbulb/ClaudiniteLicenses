{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Migrations only: deploy.yml applies them with `wrangler d1 migrations apply --remote` against
  // this file, and no Worker deploys from it. deploy.yml writes the real database_id with
  // tools/ensure-d1.mjs --write; the committed value is a placeholder.
  "name": "claudinite-licenses-db",
  "compatibility_date": "2026-08-15",
  "d1_databases": [{ "binding": "DB", "database_name": "claudinite-licenses", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }]
}
