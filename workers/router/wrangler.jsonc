{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "claudinite-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "routes": [{ "pattern": "license.claudinite.com/github-webhook", "zone_name": "claudinite.com" }],
  "services": [
    { "binding": "PUBLIC_KEY", "service": "claudinite-public-key" },
    { "binding": "KEY", "service": "claudinite-key" },
    { "binding": "SYNC", "service": "claudinite-sync" }
  ]
}
