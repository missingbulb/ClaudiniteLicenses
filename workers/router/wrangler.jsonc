{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "claudinite-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "license.claudinite.com/github-webhook", "zone_name": "claudinite.com" }],
  // KEY and SYNC are added by the chunks that build those Workers.
  "services": [{ "binding": "PUBLIC_KEY", "service": "claudinite-public-key" }]
}
