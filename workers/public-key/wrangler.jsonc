{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "claudinite-public-key",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // The webhook path has no public route: it is reached only through the router's service binding.
  "routes": [{ "pattern": "license.claudinite.com/v1/public/*", "zone_name": "claudinite.com" }],
  // Every public request's address, counted before anything is spent on it; the namespace_id is this Worker's own.
  "ratelimits": [{ "name": "IP_LIMIT", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } }],
  "analytics_engine_datasets": [{ "binding": "KEY_COUNTS", "dataset": "claudinite_key_counts" }],
  "vars": { "GITHUB_API_BASE": "https://api.github.com" }
}
