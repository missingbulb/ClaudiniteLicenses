{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "claudinite-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Everything here is public by design: the App's webhook (verified by GitHub's HMAC), health,
  // alerts and Polar's webhook (verified by its signature).
  "routes": [
    { "pattern": "license.claudinite.com/github-webhook", "zone_name": "claudinite.com" },
    { "pattern": "license.claudinite.com/v1/sync/*", "zone_name": "claudinite.com" }
  ],
  // deploy.yml writes the real database_id with tools/ensure-d1.mjs --write; the committed value is a placeholder.
  "d1_databases": [
    { "binding": "DB", "database_name": "claudinite-licenses", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../db/migrations" }
  ],
  // The nightly cron runs the GitHub and Polar reconciles; the hourly one reruns the Polar reconcile
  // only after a failure or a day without success.
  "triggers": { "crons": ["17 3 * * *", "47 * * * *"] },
  // The key Worker produces onto claudinite-licenses-writes; deploy.yml creates both queues with
  // tools/ensure-queue.mjs before either Worker deploys.
  "queues": {
    "consumers": [
      { "queue": "claudinite-licenses-writes", "max_batch_size": 100, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "claudinite-licenses-writes-dlq" },
      { "queue": "claudinite-licenses-writes-dlq", "max_batch_size": 100 }
    ]
  },
  // Every public request's address, counted before anything is spent on it (Polar's webhook only once
  // its signature fails); the namespace_id is this Worker's own.
  "ratelimits": [{ "name": "IP_LIMIT", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } }],
  // The sandbox until the commercial track flips both Workers to the production organization.
  "vars": { "GITHUB_API_BASE": "https://api.github.com", "POLAR_API_BASE": "https://sandbox-api.polar.sh" }
}
