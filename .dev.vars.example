# Every secret each Worker reads. `node tools/keys.mjs dev-chain --out .dev` writes dev values into
# .dev/<worker>.dev.vars for key and sync; `node tools/local-roundtrip.mjs` copies them beside each
# wrangler.jsonc as .dev.vars, which wrangler dev reads.

# workers/key/.dev.vars
ISSUING_KEY_PRIVATE='<base64url 32-byte seed of the license issuing key>'
ISSUING_KEY_CERT='{"payload":"...","signature":"..."}'
OIDC_ISSUER='http://127.0.0.1:<stub port>'

# workers/sync/.dev.vars
GITHUB_APP_ID='1'
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_WEBHOOK_SECRET='dev-webhook-secret'
GITHUB_API_BASE='http://127.0.0.1:<stub port>'
